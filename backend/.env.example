# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/ai_job_platform

# JWT Secrets
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Cloudinary (File Storage) - REQUIRED FOR PRODUCTION
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=dev-api-key-12345

# Email Configuration (SMTP) - REQUIRED FOR PASSWORD RESET & NOTIFICATIONS
# Option 1: Gmail (Development/Small Scale)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_NAME=AI Job Platform
FROM_EMAIL=noreply@aijobplatform.com

# Gmail Setup Instructions:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password (not your regular password)

# Option 2: SendGrid (Recommended for Production)
# Sign up at https://sendgrid.com (Free tier: 100 emails/day)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# FROM_EMAIL=verified-sender@yourdomain.com
# FROM_NAME=AI Job Platform

# Option 3: Mailgun, AWS SES, or other SMTP providers
# Configure similar to above with your provider's SMTP settings

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# API Version
API_VERSION=v1
